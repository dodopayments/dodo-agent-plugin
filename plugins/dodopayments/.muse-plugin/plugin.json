{
    "schemaVersion": 1,
    "name": "dodopayments",
    "displayName": "Dodo Payments",
    "version": "0.7.0",
    "description": "Dodo Payments for Muse Code: 1 integration agent skills plus the Dodo Payments API and documentation MCP servers.",
    "author": {
        "name": "Dodo Payments",
        "email": "support@dodopayments.com"
    },
    "compat": {
        "source": "native",
        "manifestDir": ".muse-plugin"
    },
    "capabilities": {
        "skills": [
            {
                "id": "dodo-payments",
                "path": "skills/dodo-payments/SKILL.md",
                "enabledDefault": true
            }
        ],
        "commands": [],
        "hooks": [],
        "mcpServers": [
            {
                "id": "dodopayments-api",
                "transport": "http",
                "url": "https://mcp.dodopayments.com/mcp"
            },
            {
                "id": "dodo-knowledge",
                "transport": "http",
                "url": "https://knowledge.dodopayments.com/mcp"
            }
        ],
        "reminders": []
    }
}
